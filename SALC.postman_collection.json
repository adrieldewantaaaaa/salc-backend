{
  "info": {
    "name": "SALC API",
    "description": "Smart Adaptive Learning Companion — Backend API Collection\n\nCara pakai:\n1. Import file ini ke Postman\n2. Set variable base_url = http://localhost:3000\n3. Jalankan Login dulu → token otomatis tersimpan\n4. Test endpoint lain setelah login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi@salc.id\",\n  \"password\": \"password123\",\n  \"role\": \"student\"\n}" }
          }
        },
        {
          "name": "Login (auto-save token)",
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.success && res.data.token) {", "  pm.collectionVariables.set('token', res.data.token);", "  console.log('Token saved!');", "}"] } }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"budi@salc.id\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "👤 Users",
      "item": [
        {
          "name": "Get All Users",
          "request": { "method": "GET", "url": "{{base_url}}/api/users", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Get User By ID",
          "request": { "method": "GET", "url": "{{base_url}}/api/users/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/users/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Budi Santoso Updated\",\n  \"email\": \"budi.updated@salc.id\"\n}" }
          }
        }
      ]
    },
    {
      "name": "📚 Materials",
      "item": [
        {
          "name": "Get All Materials",
          "request": { "method": "GET", "url": "{{base_url}}/api/materials", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Get Materials By Subject",
          "request": { "method": "GET", "url": "{{base_url}}/api/materials?subject=Pemrograman Dasar", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Get Material By ID",
          "request": { "method": "GET", "url": "{{base_url}}/api/materials/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Create Material (teacher/admin only)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/materials",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Pengenalan Python\",\n  \"subject\": \"Pemrograman Dasar\",\n  \"content\": \"Python adalah bahasa pemrograman yang mudah dipelajari\",\n  \"difficulty\": \"easy\"\n}" }
          }
        },
        {
          "name": "Update Material (teacher/admin only)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/materials/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Pengenalan Algoritma - Updated\",\n  \"subject\": \"Pemrograman Dasar\",\n  \"difficulty\": \"medium\"\n}" }
          }
        },
        {
          "name": "Delete Material (teacher/admin only)",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/materials/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "📈 Progress",
      "item": [
        {
          "name": "Get My Progress",
          "request": { "method": "GET", "url": "{{base_url}}/api/progress", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Get Progress Summary (Dashboard)",
          "request": { "method": "GET", "url": "{{base_url}}/api/progress/summary", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Save Progress",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/progress",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"materialId\": 1,\n  \"score\": 85,\n  \"status\": \"completed\"\n}" }
          }
        }
      ]
    },
    {
      "name": "📝 Quiz",
      "item": [
        {
          "name": "Submit Single Answer",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/quiz",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"materialId\": 1,\n  \"question\": \"Apa itu algoritma?\",\n  \"answer\": \"Algoritma adalah langkah-langkah sistematis untuk menyelesaikan masalah\",\n  \"isCorrect\": true,\n  \"score\": 100\n}" }
          }
        },
        {
          "name": "Submit Quiz (Bulk) — auto update progress",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/quiz/bulk",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"materialId\": 1,\n  \"answers\": [\n    { \"question\": \"Apa itu algoritma?\", \"answer\": \"Langkah-langkah sistematis\", \"isCorrect\": true, \"score\": 100 },\n    { \"question\": \"Apa itu variabel?\", \"answer\": \"Tempat menyimpan data\", \"isCorrect\": true, \"score\": 100 },\n    { \"question\": \"Apa itu loop?\", \"answer\": \"Saya tidak tahu\", \"isCorrect\": false, \"score\": 0 }\n  ]\n}" }
          }
        },
        {
          "name": "Get My Answers (All Materials)",
          "request": { "method": "GET", "url": "{{base_url}}/api/quiz", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Get My Answers By Material",
          "request": { "method": "GET", "url": "{{base_url}}/api/quiz/material/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Get All Students Answers (teacher/admin only)",
          "request": { "method": "GET", "url": "{{base_url}}/api/quiz/material/1/all", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "🤖 AI Predictions",
      "item": [
        {
          "name": "Auto Feedback (NLP)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/predictions/feedback",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"questionId\": 1,\n  \"answer\": \"Algoritma adalah langkah-langkah sistematis untuk menyelesaikan masalah dengan efisien\"\n}" }
          }
        }
      ]
    },
    {
      "name": "⚠️ Early Warning",
      "item": [
        {
          "name": "Check My Risk (Aktivitas Belajar)",
          "request": { "method": "GET", "url": "{{base_url}}/api/early-warning/me", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Check Risk (Performa Akademik)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/early-warning/performance",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"gender\": 0,\n  \"reading_score\": 45,\n  \"writing_score\": 40\n}" }
          }
        },
        {
          "name": "Get Unresolved Warnings (teacher/admin only)",
          "request": { "method": "GET", "url": "{{base_url}}/api/early-warning/unresolved", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Resolve Warning (teacher/admin only)",
          "request": { "method": "PATCH", "url": "{{base_url}}/api/early-warning/1/resolve", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "🎯 Recommendations",
      "item": [
        {
          "name": "Get My Recommendations (Aktivitas Belajar)",
          "request": { "method": "GET", "url": "{{base_url}}/api/recommendations", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Get Recommendations (Performa Akademik)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/recommendations/performance",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"gender\": 0,\n  \"reading_score\": 45,\n  \"writing_score\": 40\n}" }
          }
        },
        {
          "name": "Mark Recommendation As Done",
          "request": { "method": "PATCH", "url": "{{base_url}}/api/recommendations/1/done", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "🟢 Health Check",
      "item": [
        {
          "name": "Ping Server",
          "request": { "method": "GET", "url": "{{base_url}}/" }
        }
      ]
    }
  ]
}